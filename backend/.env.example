POSTGRES_DB=offerpilot
POSTGRES_USER=offerpilot
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
# 本地 HTTP 使用 false；云端启用 HTTPS 后改为 true
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=12h
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_MODE=lightweight
# 本地完整记忆模式使用 tencentdb，并填写 Memory Core 地址
MEMORY_BASE_URL=http://host.docker.internal:8420
MEMORY_TEAM_ID=offerpilot
MEMORY_AGENT_ID=offer-advisor
MEMORY_GATEWAY_API_KEY=local
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_ENABLED=false
# qwen-plus 的 Chat Completions 联网搜索由 Harness 的 realtime_web_search Skill 按需开启
CORS_ALLOWED_ORIGINS=http://localhost
